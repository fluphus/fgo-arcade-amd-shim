float calculate_phase(
	 float l_dot_e,
	 float anisotropy){//小さいほうが光が広がる。
	//const float g = g_anisotropy;//0.7f;//小さいほうが光が広がる。
	const float g = anisotropy;
	return (1.f - g) * (1.f - g) / (4.f * 3.1415926535f * pow(1.f + g * g - 2.f * g * l_dot_e, 3.f / 2.f));
}
float luminance( vec3 color){
	return dot(color, vec3(0.3f, 0.59f, 0.11f));
}
void main(){
	const float height_scale = g_height_scale;//0.275f * 2.f;//大きいほど、高度が高い箇所のフォグが弱くなる。
	vec3 global_invocation_id = gl_GlobalInvocationID.xyz;
	vec4 result = vec4(0.f, 0.f, 0.f, 0.f);
	//UVからワールド座標を計算して、その点のscattering係数を求める。
	vec4 t;
	t.xyz = global_invocation_id.xyz;
	/*{//jitter
		float dx = texelFetch(g_dither_sampler, ivec2(int(global_invocation_id.x + g_count) % 4, int(global_invocation_id.y) % 4), 0).r;
		float dy = texelFetch(g_dither_sampler, ivec2(int(global_invocation_id.x + g_count + 1) % 4, int(global_invocation_id.y + 3) % 4), 0).r;
		dx = dx * 2.f - 1.f;
		dy = dy * 2.f - 1.f;
		t.x += dx * 0.25f;
		t.y += dy * 0.25f;
	}//*/
	/*{//jitter
		//float dz = texelFetch(g_dither_sampler, ivec2(int(global_invocation_id.x + g_count) % 4, int(global_invocation_id.y) % 4), 0).r;
		float dz = (int(g_count) % 16) / 16.f;
		t.z += dz * 2.f;//なんか変だな。これで1ループする。
	}//*/
	const float slice_index = t.z;
	t.z = (exp2(slice_index * g_linear_depth_from_slice.x) + g_linear_depth_from_slice.y) * g_linear_depth_from_slice.z;
	t.w = 1.f;
	t.xy *= t.z;
	vec3 w;
	w.x = dot(g_world_from_texcoord_row0, t);
	w.y = dot(g_world_from_texcoord_row1, t);
	w.z = dot(g_world_from_texcoord_row2, t);
	const float eye_distance = length(w - g_eye_position);
	float density_attenuator = exp(-min(100.f, w.y * height_scale));
	density_attenuator *= density_attenuator;
	density_attenuator *= clamp(eye_distance * g_depth_density_scale + g_depth_density_offset, 0.f, 1.f);
	if(0.f < density_attenuator){//不要な時はテクスチャをフェッチしない。このフェッチが重い。
		//密度計算。
		float density_sample = textureLod(g_volume_noise_sampler, w.xyz * g_noise_texcoord_scale - vec3(g_noise_texcoord_offset0.x, 0.f, g_noise_texcoord_offset0.y) * 2.f, 0.f).b;
		density_sample *= textureLod(g_volume_noise_sampler, w.xyz * g_noise_texcoord_scale * 0.5f + vec3(g_noise_texcoord_offset1.x, 0.f, g_noise_texcoord_offset1.y) * 3.f, 0.f).b;
		density_sample = pow(density_sample, g_density_power);
		density_sample *= g_density_scale;
		density_sample += g_density_offset;
		density_sample *= density_attenuator;
		density_sample = min(density_sample, 1.f);
		//散乱光計算。
		const float slice_thickness = exp2(slice_index * g_linear_depth_from_slice.x) * g_linear_depth_from_slice.w;
		const float scattering_coef = g_scattering_coef;
		const float absorption_coef = g_absorption_coef;
		const float scattering = scattering_coef * density_sample * slice_thickness;
		const float absorption = absorption_coef * density_sample * slice_thickness;
		vec3 ray_direction = normalize(w - g_eye_position);
		vec3 lighting = vec3(0.f);
		{
			const float phase = calculate_phase(dot(g_parallel_light_dir.xyz, ray_direction), g_anisotropy_directional);
			float shadow = 1.f;
			{
				const float view_distance = -dot(g_view_row2, vec4(w, 1.f));
				int cascade_idx = 0;
				if(view_distance < g_plane_distances.x){
				}else if(view_distance < g_plane_distances.y){
					cascade_idx = 1;
				}else if(view_distance < g_plane_distances.z){
					cascade_idx = 2;
				}else{
				}
				vec3 shadow_uv;
				shadow_uv.x = dot(g_shadow_fetches[cascade_idx * 3 + 0], vec4(w, 1.f));
				shadow_uv.y = dot(g_shadow_fetches[cascade_idx * 3 + 1], vec4(w, 1.f));
				shadow_uv.z = dot(g_shadow_fetches[cascade_idx * 3 + 2], vec4(w, 1.f));
				shadow = min(exp(-g_exp_scale * shadow_uv.z) * textureLod(g_shadow_samplers[cascade_idx], shadow_uv.xy, 0.f).r, 1.f);
			}
			const vec3 directional_light_color = g_directional_light_color;//vec3(0.9f, 1.f, 1.25f) * 3.f;
			lighting += directional_light_color * (g_ambient_light_intensity + shadow * phase);
		}		
		vec3 summed_point_light = vec3(0.f);
		{
			vec4 proj;
			proj.x = dot(g_projection_view[0], vec4(w, 1.f));
			proj.y = dot(g_projection_view[1], vec4(w, 1.f));
			proj.z = dot(g_projection_view[2], vec4(w, 1.f));
			proj.w = dot(g_projection_view[3], vec4(w, 1.f));
			Tile tile;
			fetch_tile(tile, proj);
			const int ln = tile.m_count;
			int idx = tile.m_index_offset;
			for(int i = 0; i < ln; ++ i){
				Light lgt;
				fetch_light(lgt, idx);
				vec3 l = lgt.m_sphere.xyz - w;
				float ll = dot(l, l);
				l *= 1.f / (sqrt(ll) + 0.00001f);
				const float cone_attenuation = calculate_spot_attenuation(lgt.m_packed, l);
				const float phase = calculate_phase(dot(l, ray_direction), g_anisotropy_point);
				float rr = lgt.m_sphere.w * lgt.m_sphere.w;
				float s = clamp(ll / rr, 0.f, 1.f);
				s *= s;
				s = 1.f - s;
				const float min_radius = 1.f;//適当。無いと発光するため。
				summed_point_light += lgt.m_color.rgb / max(min_radius * min_radius, ll) * s * cone_attenuation * phase;//散乱光ということで。
				//summed_point_light += lgt.m_color.rgb * s * cone_attenuation * phase * 0.02f;//散乱光ということで。
				++ idx;
			}
			//lighting += summed_point_light * 1.5f;
			lighting += summed_point_light * g_point_light_intensity_scale;
		}
		lighting *= g_fog_albedo;
		//extinction=scattering+absorption
		//	absorption=extinction-scattering
		result = vec4(lighting * scattering, scattering * g_scattering_abosorption_ratio + absorption);//g_scattering_abosorption_ratioは見た目の調整値。エネルギーの保存としては1が正しい。0にすると散乱光が加算になる。//lightingの輝度を消滅係数には計上しない。
	}
	{//適当に線形fogを混ぜ合わせる。
		float depth_fog_intensity = clamp(eye_distance * g_depth_fog_scale + g_depth_fog_offset, 0.f, 1.f) * g_depth_fog_color.w;
		//scattering += depth_fog_intensity;
		//lighting += g_depth_fog_color.rgb;
		result.w += depth_fog_intensity;
		result.rgb += g_depth_fog_color.rgb * depth_fog_intensity;
	}
	imageStore(g_output, ivec3(global_invocation_id), result);
}
layout(local_size_x = 5, local_size_y = 30, local_size_z = 1) in;
