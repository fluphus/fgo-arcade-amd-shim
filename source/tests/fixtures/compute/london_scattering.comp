vec4 color_from_lod( float lod){
	vec3 pallets[4] = {
		vec3(0.f, 0.f, 1.f),
		vec3(0.f, 1.f, 0.f),
		vec3(1.f, 1.f, 0.f),
        vec3(1.f, 0.f, 0.f),
